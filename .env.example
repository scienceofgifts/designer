# Cloudflare Worker API URL for Gemini Analysis (Frontend build-time config)
# In production, set this to your deployed Cloudflare Worker URL:
# e.g.: VITE_GEMINI_API_URL="https://designdna-api.scienceofgifts.workers.dev"
# If left empty/unset in local dev, requests default to relative "/api/*" (proxied to server.ts).
VITE_GEMINI_API_URL="https://designdna-api.scienceofgifts.workers.dev"

# Server-Side / Cloudflare Worker Secret (NEVER expose to frontend JavaScript or client bundles!)
# For Cloudflare Worker: run `npx wrangler secret put GEMINI_API_KEY` in the worker/ directory
# For local dev server: automatically read from server environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
